# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/aml
DATABASE_URL_RO=postgresql+psycopg://copilot_ro:copilot_ro@localhost:5433/aml
DATABASE_URL_RW=postgresql+psycopg://copilot_rw:copilot_rw@localhost:5433/aml
OPENAI_API_KEY=
# Check https://platform.openai.com/docs/models and set the current names
MODEL_SMALL=gpt-4.1-mini
MODEL_STRONG=gpt-4.1
EMBED_MODEL=text-embedding-3-small
# Must match vector(N) in db/init/01_schema.sql
EMBED_DIM=1536
PROMPT_VERSION=1
LANGSMITH_API_KEY=
